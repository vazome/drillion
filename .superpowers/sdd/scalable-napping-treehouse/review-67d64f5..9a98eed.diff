+def read_first(src):
+    """The `# READ FIRST:` block after the module docstring, `#` stripped."""
+    tree = ast.parse(src)
+    lines = src.split("\n")
+    at = tree.body[0].end_lineno if tree.body and _str_expr(tree.body[0]) else 0
+    while at < len(lines) and not lines[at].strip():
