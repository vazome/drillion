+    margin = len(spec_src) - len(spec_src.lstrip(" \t"))   # 4 on a pristine file, 2 after a 2-space save
+    spec = [pre + ln[margin:] if ln.strip() else ln for ln in spec_src.split("\n")]
+    return "\n".join(lines[:first.lineno - 1] + spec + rest)
+
